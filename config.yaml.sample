TELEGRAM_USER_ID: 8786836755
TELEGRAM_TOKENS:
  chat1: "TELEGRAM_TOKEN"
  chat2: "TELEGRAM_TOKEN"

# GitHub token for gist installation (increases rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN: "your-github-token"

PROVIDERS:
  - name: "local-ollama"
    type: "ollama"
    url: "http://192.168.1.201:11434"
    show_on_provider_list: true
  - name: "local-ollama-2"
    type: "ollama"
    url: "http://192.168.1.202:9931"
    show_on_provider_list: true
  - name: "openrouter"
    type: "openai_compatible"
    url: "https://openrouter.ai/api/v1"
    api_key: "your-openrouter-api-key"
    show_on_provider_list: true
    extra_headers:
      HTTP-Referer: "https://github.com/your-repo"
      X-Title: "Vivid Chat"
  - name: "llamacpp"
    type: "openai_compatible"
    url: "http://192.168.1.162:9931/v1"
    # llama.cpp serves models at /models (not /v1/models), so specify models_url:
    models_url: "http://192.168.1.162:9931/models"
    show_on_provider_list: true
  - name: "llamacpp-ollama"
    type: "ollama"
    url: "http://localhost:8080"
    show_on_provider_list: true
  - name: "llamacpp-remote"
    type: "openai_compatible"
    url: "https://your-proxy-url/v1"
    api_key: "optional-if-auth-required"
    show_on_provider_list: true
  - name: "gemini"
    type: "gemini"
    api_key: "your-gemini-api-key"
    show_on_provider_list: true
  # NVIDIA NIM (build.nvidia.com) - OpenAI-compatible endpoint.
  # Get a key at https://build.nvidia.com -> any model page -> "Get API Key".
  # Model ids look like "nvidia/nemotron-3-super-120b-a12b",
  # "meta/llama-3.3-70b-instruct" or "openai/gpt-oss-120b";
  # use `.model` to list what your key can use.
  - name: "nvidia"
    type: "openai_compatible"
    url: "https://integrate.api.nvidia.com/v1"
    api_key: "nvapi-your-nvidia-api-key"
    model: "nvidia/nemotron-3-super-120b-a12b"
    show_on_provider_list: true

OLLAMA_NUM_CTX: 4096

# Voice / TTS Settings (for .voice on/off command)
# DEFAULT_VOICE: "en-US-AvaNeural"
# Voice list lives in settings/voices.json; `.nar` lists it and `.nar [n]` selects.
# `.voice [n]` sets speed: 1 = 1.0x (normal), 2 = 1.2x, ... 9+ = 1.9x (max).

